# ---------------------------------------------------------------------------
# Admin PIN (required in production). 4 digits. Falls back to 4242 in dev only.
# ---------------------------------------------------------------------------
ADMIN_PIN=4242
# Secret used to sign the admin session cookie. Generate: openssl rand -hex 32
ADMIN_SESSION_SECRET=

# ---------------------------------------------------------------------------
# Supabase. Leave blank to run on the bundled local JSON store (.data/).
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Only needed for `npm run setup`, which builds the database for you.
# Supabase: Settings -> Database -> Connection string -> URI
SUPABASE_DB_URL=
SUPABASE_STORAGE_BUCKET=products

# Set to 1 to run a PRODUCTION build on the local JSON store. Only for a local
# smoke test — on a real host the store is per-instance and orders are lost.
ALLOW_LOCAL_STORE=

# ---------------------------------------------------------------------------
# Notifications. Both optional — unset means "log to the server console".
# ---------------------------------------------------------------------------
RESEND_API_KEY=
RESEND_FROM="Nightcrawler <orders@nightcrawler.example>"

TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=

# Absolute origin used to build tracker links in SMS/email.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
